{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@dowel-ui/docs", "dev"],
      "port": 3333
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dowel-ui/react",
        "exec",
        "storybook",
        "dev",
        "-p",
        "6007",
        "--no-open"
      ],
      "port": 6007
    }
  ]
}
