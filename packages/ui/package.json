{
  "name": "@dowel-ui/react",
  "version": "0.1.1",
  "type": "module",
  "description": "Source-first React components.",
  "license": "MIT",
  "homepage": "https://dowel-eight.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqkprogrammer/dowel-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/aqkprogrammer/dowel-ui/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry/components.d.ts",
      "default": "./dist/registry/components.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist coverage storybook-static .turbo"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.6.7",
    "react-day-picker": "10.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@dowel-ui/config": "workspace:*",
    "@dowel-ui/themes": "workspace:*",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "lucide-react": "1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "zod": "4.5.4"
  }
}
