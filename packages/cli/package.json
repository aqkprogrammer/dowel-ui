{
  "name": "@dowel-ui/cli",
  "version": "0.1.1",
  "type": "module",
  "description": "Adds components to your project as source you own.",
  "files": [
    "dist"
  ],
  "bin": {
    "dowel": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@dowel-ui/config": "workspace:*",
    "@dowel-ui/registry": "workspace:*",
    "@types/node": "26.4.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
