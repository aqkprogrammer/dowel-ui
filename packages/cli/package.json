{
  "name": "@dowel-ui/cli",
  "version": "0.7.0",
  "type": "module",
  "description": "Installs Dowel components into your project as source you own, with dependencies resolved and imports rewritten to your path aliases.",
  "keywords": [
    "cli",
    "react",
    "ui",
    "components",
    "component-library",
    "design-system",
    "tailwind",
    "scaffolding",
    "registry",
    "code-generation",
    "shadcn",
    "source-first",
    "dowel"
  ],
  "license": "MIT",
  "homepage": "https://dowel-eight.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqkprogrammer/dowel-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/aqkprogrammer/dowel-ui/issues"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "dowel": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@dowel-ui/config": "workspace:*",
    "@dowel-ui/registry": "workspace:*",
    "@types/node": "26.4.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
