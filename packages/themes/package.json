{
  "name": "@dowel-ui/themes",
  "version": "0.1.1",
  "type": "module",
  "description": "Design tokens and theme presets.",
  "license": "MIT",
  "homepage": "https://dowel-eight.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqkprogrammer/dowel-ui.git",
    "directory": "packages/themes"
  },
  "bugs": {
    "url": "https://github.com/aqkprogrammer/dowel-ui/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/index.css",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./presets.css": "./src/presets/index.css",
    "./presets/*.css": "./src/presets/*.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@dowel-ui/config": "workspace:*",
    "tailwindcss": "4.3.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  }
}
