{
  "name": "@dowel-ui/registry",
  "version": "0.6.0",
  "type": "module",
  "description": "Builds the static component registry that the Dowel CLI installs from. For hosting your own registry or a fork.",
  "keywords": [
    "registry",
    "build-tool",
    "component-registry",
    "react",
    "design-system",
    "tooling",
    "dowel"
  ],
  "license": "MIT",
  "homepage": "https://dowel-eight.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqkprogrammer/dowel-ui.git",
    "directory": "packages/registry"
  },
  "bugs": {
    "url": "https://github.com/aqkprogrammer/dowel-ui/issues"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "default": "./dist/generate.js"
    }
  },
  "bin": {
    "build-registry": "./dist/build.js"
  },
  "scripts": {
    "build": "tsdown && tsx src/build.ts --out r",
    "build:registry": "tsx src/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo r"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@dowel-ui/config": "workspace:*",
    "@dowel-ui/themes": "workspace:*",
    "@dowel-ui/react": "workspace:*",
    "@types/node": "26.4.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
